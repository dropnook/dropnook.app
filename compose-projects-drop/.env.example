# Dropnook — your values; compose.yaml stays as it is. Comments only on lines of their own.
# Special characters ($ # " or spaces at the end): in single quotes, e.g. PIN='a$b#c'

# Address of drop in your network, e.g. 192.168.1.20
DROP_IP=
# Address of drop-share, where your reverse proxy points, e.g. 192.168.1.21
SHARE_IP=

# The Unraid share "drop" — create it first
DATA_DIR=/mnt/user/drop
# Translations of your own; may stay empty
APPDATA_DIR=/mnt/user/appdata/drop
# Folder with your certificates, read-only — never the appdata folder above
CERTS_DIR=/mnt/user/appdata/Nginx-Proxy-Manager-Official/letsencrypt
# auto | yourdomain.com | path of fullchain.pem | empty: no HTTPS
TLS_CERT=auto
# Only with a path in TLS_CERT: path of privkey.pem
TLS_KEY=

# Certificates from Cert Warden instead (replaces CERTS_DIR/TLS_CERT), e.g. https://certwarden.example.org
CERTWARDEN_ENDPOINT_URL=
# drop's certificate: its name in Cert Warden, API key of the certificate, API key of the private key
CERT_INT_NAME=
CERT_INT_CERT_API=
CERT_INT_KEY_API=
# drop-share's certificate (HTTPS on its port 443); empty: drop's, if it covers drop-share (wildcard)
CERT_PUB_NAME=
CERT_PUB_CERT_API=
CERT_PUB_KEY_API=
# Fetch a new certificate this many days before the current one expires
CERT_CHECK_DAY=30

# First part of the share links' name: https://drop-share.yourdomain.com/…
SHARE_SUBDOMAIN=drop-share
# What "WebUI" in the Docker tab opens, and a name Drop answers to; without a domain: http://[IP]/
WEBUI=https://drop.yourdomain.com
# More names Drop answers to, if any: drop.example.net,*.example.org
HOSTS=
# Time zone of the log, e.g. Europe/Berlin; empty: UTC
TZ=

# PIN or password for everyone; with users: the PIN of users without their own
PIN=
# Users, one per colour: name:PIN, or the name alone
USER_TEAL=
USER_GOLD=
USER_BLUE=
USER_VIOLET=
USER_CORAL=
