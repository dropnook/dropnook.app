# Dropnook — your values. compose.yaml stays as it is; everything you set up
# goes in here.
#   Unraid (Compose Manager Plus): Edit Stack → tab .env — paste this, fill in, Save.
#   Elsewhere: save it as .env next to compose.yaml.
# Then Compose Up; the log of drop says what it found.
#
# Comments only on lines of their own, never behind a value.
# Special characters ($ # " or spaces at the end): single quotes, e.g. PIN='a$b#c'

# --- Required: two free addresses in your LAN --------------------------------
# drop — the page in your network, e.g. 192.168.1.20
DROP_IP=
# drop-share — the share links, where your reverse proxy points, e.g. 192.168.1.21
SHARE_IP=

# --- Folders -----------------------------------------------------------------
# The Unraid share "drop" — create it first
DATA_DIR=/mnt/user/drop
# Translations of your own; may stay empty
APPDATA_DIR=/mnt/user/appdata/drop
# Your certificates, read-only. Never the appdata folder above.
CERTS_DIR=/mnt/user/appdata/Nginx-Proxy-Manager-Official/letsencrypt

# --- HTTPS in your network ---------------------------------------------------
# auto | yourdomain.com | the path of fullchain.pem | empty: no HTTPS
TLS_CERT=auto
# Only with a path in TLS_CERT: the path of privkey.pem
TLS_KEY=

# --- Names -------------------------------------------------------------------
# First part of the share links' name: https://drop-share.yourdomain.com/…
SHARE_SUBDOMAIN=drop-share
# Your name for Drop: what "WebUI" in the Docker tab opens, and a name Drop
# answers to (besides IP addresses and local names). Without a domain: http://[IP]/
WEBUI=https://drop.yourdomain.com
# More names Drop answers to, if you use any: drop.example.net,*.example.org
HOSTS=
# Time zone of the log timestamps, e.g. Europe/Berlin; empty: UTC
TZ=

# --- Who gets in (optional) --------------------------------------------------
# One PIN or password for everyone. With users: the PIN of every user without
# one of their own.
PIN=
# Users, one per colour: name:PIN — or the name alone, without a PIN. Each gets
# an area of their own next to the shared one, and the page in their colour.
USER_TEAL=
USER_GOLD=
USER_BLUE=
USER_VIOLET=
USER_CORAL=
